# El puerto que escucha el servicio.
PORT=3000

# Origenes permitidos, separados por coma. Una lista vacia no permite ninguno:
# un contenedor que nadie configuro falla cerrado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upstream declarado con defineUpstream('academic'). Sin esta variable el
# servicio no arranca, y el error nombra la variable.
ACADEMIC_URL=http://localhost:4010
ACADEMIC_TIMEOUT_MS=3000
