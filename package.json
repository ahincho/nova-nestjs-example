{
  "name": "nova-nestjs-example",
  "version": "0.1.0",
  "private": true,
  "description": "A reference NestJS service built on the Nova Platform meta-framework",
  "license": "EPL-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ahincho/nova-nestjs": "^0.6.0"
  },
  "devDependencies": {
    "@ahincho/nova-nestjs-schematics": "^0.6.0",
    "@ahincho/nova-nestjs-toolchain": "^0.6.0"
  }
}
